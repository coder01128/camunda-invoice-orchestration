<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_supplier-query" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Claude Code" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="supplier-query" name="Supplier Query" isExecutable="true">
    <bpmn:documentation>Call activity. In: invoice, queryReason. Out: queryOutcome {outcome, notes, handledBy}. Creditors team contacts the supplier and records how the query closed.</bpmn:documentation>
    <bpmn:startEvent id="Start_query" name="Query needed"><bpmn:outgoing>Flow_Start_query_QuerySupplier</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="QuerySupplier" name="Query supplier"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="supplier-query" /><zeebe:assignmentDefinition candidateGroups="creditors" /><zeebe:ioMapping><zeebe:output source="={outcome: outcome, notes: notes, handledBy: handledBy}" target="queryOutcome" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Start_query_QuerySupplier</bpmn:incoming><bpmn:outgoing>Flow_QuerySupplier_End_query</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="End_query" name="Query closed"><bpmn:incoming>Flow_QuerySupplier_End_query</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_query_QuerySupplier" sourceRef="Start_query" targetRef="QuerySupplier"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_QuerySupplier_End_query" sourceRef="QuerySupplier" targetRef="End_query"></bpmn:sequenceFlow>
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_supplier-query">
    <bpmndi:BPMNPlane id="BPMNPlane_supplier-query" bpmnElement="supplier-query">
      <bpmndi:BPMNShape id="Start_query_di" bpmnElement="Start_query"><dc:Bounds x="182" y="132" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="QuerySupplier_di" bpmnElement="QuerySupplier"><dc:Bounds x="320" y="110" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_query_di" bpmnElement="End_query"><dc:Bounds x="522" y="132" width="36" height="36" /></bpmndi:BPMNShape>
      
      <bpmndi:BPMNEdge id="Flow_Start_query_QuerySupplier_di" bpmnElement="Flow_Start_query_QuerySupplier"><di:waypoint x="218" y="150" /><di:waypoint x="320" y="150" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_QuerySupplier_End_query_di" bpmnElement="Flow_QuerySupplier_End_query"><di:waypoint x="420" y="150" /><di:waypoint x="522" y="150" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
