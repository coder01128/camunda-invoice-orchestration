<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_approval-routing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Claude Code" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="approval-routing" name="Approval Routing" isExecutable="true">
    <bpmn:documentation>Shared call activity. In: amount, category, flagReason, flagged (optional), approvalLimits (optional override; default = cluster variable approvalLimits), escalationTimeout (optional, default PT24H), sourceRef/supplier (display). Out: approvalOutcome {approved, approver, tier, escalated, comment}.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_approval" name="Approval requested"><bpmn:outgoing>Flow_StartEvent_approval_ResolveLimits</bpmn:outgoing></bpmn:startEvent>
    <bpmn:scriptTask id="ResolveLimits" name="Resolve approval limits"><bpmn:documentation>Caller-supplied approvalLimits win; otherwise the admin-managed cluster variable approvalLimits; otherwise null (fail-safe: director).</bpmn:documentation><bpmn:extensionElements><zeebe:script expression="=if approvalLimits != null then approvalLimits else camunda.vars.env.approvalLimits" resultVariable="resolvedLimits" /><zeebe:ioMapping><zeebe:output source="=resolvedLimits" target="approvalLimits" /><zeebe:output source="=if limitsSource != null then limitsSource else if resolvedLimits = null or resolvedLimits.autoApproveMax = null then &#34;NONE SUPPLIED - fail-safe routes to director&#34; else if resolvedLimits.source != null then resolvedLimits.source else &#34;cluster configuration&#34;" target="limitsSource" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_StartEvent_approval_ResolveLimits</bpmn:incoming><bpmn:outgoing>Flow_ResolveLimits_DetermineTier</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:businessRuleTask id="DetermineTier" name="Determine approval tier"><bpmn:extensionElements><zeebe:calledDecision decisionId="approval-tier" resultVariable="approvalTier" /></bpmn:extensionElements><bpmn:incoming>Flow_ResolveLimits_DetermineTier</bpmn:incoming><bpmn:outgoing>Flow_DetermineTier_Gateway_tier</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_tier" name="Tier?" default="Flow_Gateway_tier_Gateway_director_join"><bpmn:incoming>Flow_DetermineTier_Gateway_tier</bpmn:incoming><bpmn:outgoing>Flow_Gateway_tier_AutoApprove</bpmn:outgoing><bpmn:outgoing>Flow_Gateway_tier_ManagerReview</bpmn:outgoing><bpmn:outgoing>Flow_Gateway_tier_Gateway_director_join</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="AutoApprove" name="Auto-approve"><bpmn:extensionElements><zeebe:script expression="={approved: true, approver: &#34;system:auto-approve&#34;, tier: &#34;auto&#34;, escalated: false, comment: null}" resultVariable="approvalOutcome" /></bpmn:extensionElements><bpmn:incoming>Flow_Gateway_tier_AutoApprove</bpmn:incoming><bpmn:outgoing>Flow_AutoApprove_Gateway_merge</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:userTask id="ManagerReview" name="Manager review"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="approval-review" /><zeebe:assignmentDefinition candidateGroups="manager" /><zeebe:ioMapping><zeebe:output source="={approved: if decision = null then approved else decision = &#34;approve&#34;, approver: approver, tier: &#34;manager&#34;, escalated: false, comment: comment}" target="approvalOutcome" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gateway_tier_ManagerReview</bpmn:incoming><bpmn:outgoing>Flow_ManagerReview_Gateway_merge</bpmn:outgoing></bpmn:userTask>
    <bpmn:boundaryEvent id="ManagerTimeout" name="No response" cancelActivity="true" attachedToRef="ManagerReview"><bpmn:outgoing>Flow_ManagerTimeout_Gateway_director_join</bpmn:outgoing><bpmn:timerEventDefinition id="ManagerTimeout_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=if escalationTimeout != null then escalationTimeout else &#34;PT24H&#34;</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_director_join"><bpmn:incoming>Flow_Gateway_tier_Gateway_director_join</bpmn:incoming><bpmn:incoming>Flow_ManagerTimeout_Gateway_director_join</bpmn:incoming><bpmn:outgoing>Flow_Gateway_director_join_DirectorReview</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="DirectorReview" name="Director review"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="approval-review" /><zeebe:assignmentDefinition candidateGroups="director" /><zeebe:ioMapping><zeebe:output source="={approved: if decision = null then approved else decision = &#34;approve&#34;, approver: approver, tier: &#34;director&#34;, escalated: approvalTier = &#34;manager&#34;, comment: comment}" target="approvalOutcome" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Gateway_director_join_DirectorReview</bpmn:incoming><bpmn:outgoing>Flow_DirectorReview_Gateway_merge</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_merge"><bpmn:incoming>Flow_AutoApprove_Gateway_merge</bpmn:incoming><bpmn:incoming>Flow_ManagerReview_Gateway_merge</bpmn:incoming><bpmn:incoming>Flow_DirectorReview_Gateway_merge</bpmn:incoming><bpmn:outgoing>Flow_Gateway_merge_EndEvent_approval</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_approval" name="Decision made"><bpmn:incoming>Flow_Gateway_merge_EndEvent_approval</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartEvent_approval_ResolveLimits" sourceRef="StartEvent_approval" targetRef="ResolveLimits"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ResolveLimits_DetermineTier" sourceRef="ResolveLimits" targetRef="DetermineTier"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DetermineTier_Gateway_tier" sourceRef="DetermineTier" targetRef="Gateway_tier"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_tier_AutoApprove" name="auto" sourceRef="Gateway_tier" targetRef="AutoApprove"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalTier = &#34;auto&#34;</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_tier_ManagerReview" name="manager" sourceRef="Gateway_tier" targetRef="ManagerReview"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalTier = &#34;manager&#34;</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_tier_Gateway_director_join" name="director" sourceRef="Gateway_tier" targetRef="Gateway_director_join"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManagerTimeout_Gateway_director_join" sourceRef="ManagerTimeout" targetRef="Gateway_director_join"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_director_join_DirectorReview" sourceRef="Gateway_director_join" targetRef="DirectorReview"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AutoApprove_Gateway_merge" sourceRef="AutoApprove" targetRef="Gateway_merge"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManagerReview_Gateway_merge" sourceRef="ManagerReview" targetRef="Gateway_merge"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DirectorReview_Gateway_merge" sourceRef="DirectorReview" targetRef="Gateway_merge"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_merge_EndEvent_approval" sourceRef="Gateway_merge" targetRef="EndEvent_approval"></bpmn:sequenceFlow>
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_approval-routing">
    <bpmndi:BPMNPlane id="BPMNPlane_approval-routing" bpmnElement="approval-routing">
      <bpmndi:BPMNShape id="StartEvent_approval_di" bpmnElement="StartEvent_approval"><dc:Bounds x="182" y="272" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ResolveLimits_di" bpmnElement="ResolveLimits"><dc:Bounds x="320" y="250" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DetermineTier_di" bpmnElement="DetermineTier"><dc:Bounds x="490" y="250" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_tier_di" bpmnElement="Gateway_tier" isMarkerVisible="true"><dc:Bounds x="685" y="265" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AutoApprove_di" bpmnElement="AutoApprove"><dc:Bounds x="830" y="110" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ManagerReview_di" bpmnElement="ManagerReview"><dc:Bounds x="830" y="250" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_director_join_di" bpmnElement="Gateway_director_join" isMarkerVisible="true"><dc:Bounds x="1025" y="405" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DirectorReview_di" bpmnElement="DirectorReview"><dc:Bounds x="1170" y="390" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_merge_di" bpmnElement="Gateway_merge" isMarkerVisible="true"><dc:Bounds x="1365" y="265" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_approval_di" bpmnElement="EndEvent_approval"><dc:Bounds x="1542" y="272" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ManagerTimeout_di" bpmnElement="ManagerTimeout"><dc:Bounds x="900" y="312" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_StartEvent_approval_ResolveLimits_di" bpmnElement="Flow_StartEvent_approval_ResolveLimits"><di:waypoint x="218" y="290" /><di:waypoint x="320" y="290" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ResolveLimits_DetermineTier_di" bpmnElement="Flow_ResolveLimits_DetermineTier"><di:waypoint x="420" y="290" /><di:waypoint x="490" y="290" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DetermineTier_Gateway_tier_di" bpmnElement="Flow_DetermineTier_Gateway_tier"><di:waypoint x="590" y="290" /><di:waypoint x="685" y="290" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_tier_AutoApprove_di" bpmnElement="Flow_Gateway_tier_AutoApprove"><di:waypoint x="710" y="265" /><di:waypoint x="710" y="150" /><di:waypoint x="830" y="150" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_tier_ManagerReview_di" bpmnElement="Flow_Gateway_tier_ManagerReview"><di:waypoint x="735" y="290" /><di:waypoint x="830" y="290" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_tier_Gateway_director_join_di" bpmnElement="Flow_Gateway_tier_Gateway_director_join"><di:waypoint x="710" y="315" /><di:waypoint x="710" y="430" /><di:waypoint x="1025" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerTimeout_Gateway_director_join_di" bpmnElement="Flow_ManagerTimeout_Gateway_director_join"><di:waypoint x="918" y="348" /><di:waypoint x="918" y="430" /><di:waypoint x="1025" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_director_join_DirectorReview_di" bpmnElement="Flow_Gateway_director_join_DirectorReview"><di:waypoint x="1075" y="430" /><di:waypoint x="1170" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AutoApprove_Gateway_merge_di" bpmnElement="Flow_AutoApprove_Gateway_merge"><di:waypoint x="930" y="150" /><di:waypoint x="1390" y="150" /><di:waypoint x="1390" y="265" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ManagerReview_Gateway_merge_di" bpmnElement="Flow_ManagerReview_Gateway_merge"><di:waypoint x="930" y="290" /><di:waypoint x="1365" y="290" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DirectorReview_Gateway_merge_di" bpmnElement="Flow_DirectorReview_Gateway_merge"><di:waypoint x="1270" y="430" /><di:waypoint x="1390" y="430" /><di:waypoint x="1390" y="315" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_merge_EndEvent_approval_di" bpmnElement="Flow_Gateway_merge_EndEvent_approval"><di:waypoint x="1415" y="290" /><di:waypoint x="1542" y="290" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
